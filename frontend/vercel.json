{
  "routes": [
    {
      "src": "^/licenses/privacy$",
      "status": 308,
      "headers": {
        "Location": "https://experts.speede.site/licenses/privacy"
      }
    },
    {
      "src": "^/licenses/terms$",
      "status": 308,
      "headers": {
        "Location": "https://experts.speede.site/licenses/terms"
      }
    },
    {
      "src": "^/(index\\.html)?$",
      "has": [
        {
          "type": "query",
          "key": "fileId"
        }
      ],
      "dest": "/api/share"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ],
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "framework": "vite"
}
