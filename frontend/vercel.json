{
  "redirects": [
    {
      "source": "/licenses/privacy",
      "destination": "https://speede-pi.vercel.app/licenses/privacy",
      "permanent": true
    },
    {
      "source": "/licenses/terms",
      "destination": "https://speede-pi.vercel.app/licenses/terms",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "framework": "vite"
}
